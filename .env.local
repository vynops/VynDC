# VynDC Environment Configuration
# ─────────────────────────────────────────────────────────────
# Bootstrap admin credentials (used on first boot to create the admin account)
VYNDC_ADMIN_EMAIL=admin@vyndc.local
VYNDC_ADMIN_PASSWORD=changeme

# JWT secret — change this to a long random string in production
VYNDC_SECRET=replace-with-a-long-random-secret-string

# Groq API key (optional — can also be set from Settings → AI Copilot in the UI)
GROQ_API_KEY=

# Server port (default 3040)
PORT=3040
